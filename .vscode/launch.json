      "address": "localhost",
      "port": 9234,
      "localRoot": "${workspaceFolder}/backend/modules/AI-and-execution-layer/actions-engine",
      "remoteRoot": "/workspace/modules/AI-and-execution-layer/actions-engine",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend/modules/AI-and-execution-layer/actions-engine/dist/**/*.js"]
    },
    {
      "name": "app-config",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9235,

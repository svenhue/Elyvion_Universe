{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    },
    {
      "name": "auth",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9230,
      "localRoot": "${workspaceFolder}/backend/modules/security-layer/auth",
      "remoteRoot": "/workspace/modules/security-layer/auth",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend/modules/security-layer/auth/dist/**/*.js"]
    },
    {
      "name": "security",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9231,
      "localRoot": "${workspaceFolder}/backend/modules/security-layer/security",
      "remoteRoot": "/workspace/modules/security-layer/security",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend/modules/security-layer/security/dist/**/*.js"]
    },
    {
      "name": "registry",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9232,
      "localRoot": "${workspaceFolder}/backend/modules/registry",
      "remoteRoot": "/workspace/modules/registry",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend/modules/registry/dist/**/*.js"]
    },
    {
      "name": "gateway",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9233,

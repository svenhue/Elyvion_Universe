      "outFiles": ["${workspaceFolder}/backend/modules/AI-and-execution-layer/workflow-engine/dist/**/*.js"]
    },
    {
      "name": "agent-engine",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9250
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend/modules/AI-and-execution-layer/agent-engine",
          "remoteRoot": "/workspace/backend/modules/AI-and-execution-layer/agent-engine"
        }
      ]
    },
    {
      "name": "ontology-engine",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9251
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend/modules/knowledge-layer/ontology-engine",
          "remoteRoot": "/workspace/backend/modules/knowledge-layer/ontology-engine"
        }
      ]
    },
    {
      "name": "elyvion-platform",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9252
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend/elyvion_platform",
          "remoteRoot": "/workspace/backend/elyvion_platform"
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Backend (alle Services)",
      "configurations": [
        "auth",
        "security",
        "registry",
        "gateway",
        "actions-engine",
        "app-config",
        "chat",
        "data-adapters",
        "data-engine",
        "deployment-engine",
        "integrations",
        "local-llm",
        "repository",
        "rules-engine",
        "solutions",
        "telemetry",
        "traffic",
        "version-control",
        "workflow-engine",
        "agent-engine",
        "ontology-engine",
        "elyvion-platform"
      ],
      "stopAll": true
    },
    {
      "name": "Alles (Frontend + Backend)",
      "configurations": [
        "Frontend (Chrome)",
        "auth",
        "security",
        "registry",
        "gateway",
        "actions-engine",
        "app-config",
        "chat",
        "data-adapters",
        "data-engine",
        "deployment-engine",
        "integrations",
        "local-llm",
        "repository",
        "rules-engine",
        "solutions",
        "telemetry",
        "traffic",
        "version-control",
        "workflow-engine",
        "agent-engine",
        "ontology-engine",
        "elyvion-platform"
      ],
      "stopAll": true

// Custom output path: pnpm dedupes identical @prisma/client versions across
// workspace packages into one physical copy, so the default (shared)
// output location gets overwritten by whichever module generates last.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogLevel {
  debug
  info
  warn
  error
}

/// One log entry, from any module (backend or frontend) in the
/// environment — "eigentlich sollte wirklich alles geloggt werden". The
/// Actions system is the main emitter in practice: every action call,
/// wherever it's executed (actions-engine's own ActionsController, or
/// the frontend's FrontendActionsService), writes one of these, so "every
/// action" coverage falls out of that one integration point rather than
/// needing every action's own implementation to remember to log.
model LogEntry {
  id        String   @id @default(uuid())
  /// The module (or "frontend") that emitted this entry — not necessarily
  /// who *triggered* the thing being logged.
  source    String
  level     LogLevel @default(info)
  message   String
  /// The action key this entry is about, if any — lets the UI filter to
  /// "every log for this action" without parsing `context`.
  actionKey String?
  /// Arbitrary structured metadata (e.g. an action's input/output/error).
  context   Json?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([actionKey])
  @@index([createdAt])
}

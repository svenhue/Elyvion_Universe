generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubjectType {
  user
  agent
}

enum AccessEffect {
  allow
  deny
}

enum TenantStatus {
  active
  suspended
}

enum TenantMembershipStatus {
  active
  invited
  suspended
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String?
  createdAt    DateTime           @default(now())
  memberships  TenantMembership[]
}

model Tenant {
  id          String             @id @default(uuid())
  name        String
  status      TenantStatus       @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]

  @@index([status, name])
}

model TenantMembership {
  id        String                  @id @default(uuid())
  tenantId  String
  userId    String
  status    TenantMembershipStatus @default(active)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

/// One backend module = one Resource — self-registered by the module
/// itself, the same way it self-registers its actions with actions-engine.
model Resource {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
}

/// One grantable capability within a Resource (e.g. data-adapters:
/// create_data_adapter) — modules expose these alongside their actions and
/// assign one to each action that needs gating.
model Permission {
  id                String             @id @default(uuid())
  resourceId        String
  resource          Resource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  key               String
  name              String
  description       String?
  createdAt         DateTime           @default(now())
  rolePermissions   RolePermission[]
  objectPermissions ObjectPermission[]

  @@unique([resourceId, key])
}

/// A named set of permissions. Platform super-admin roles bypass permission
/// grants across existing tenants. Roles can inherit from other roles
/// (`RoleInheritance`) — "eine Rolle kann die Rechte von anderen Rollen
/// erben" — so a role's *effective* permissions are its own direct grants
/// plus everything every ancestor role grants, resolved at
/// authorization time (see `authorization/role-resolver.service.ts`).
model Role {
  id            String           @id @default(uuid())
  key           String           @unique
  name          String
  description   String?
  isSuperAdmin  Boolean          @default(false)
  createdAt     DateTime         @default(now())
  permissions   RolePermission[]
  assignments   RoleAssignment[]

  /// Roles this role directly inherits from.
  parentsOf  RoleInheritance[] @relation("ChildRole")
  /// Roles that directly inherit from this role.
  childrenOf RoleInheritance[] @relation("ParentRole")
}

model RoleInheritance {
  id           String @id @default(uuid())
  childRoleId  String
  childRole    Role   @relation("ChildRole", fields: [childRoleId], references: [id], onDelete: Cascade)
  parentRoleId String
  parentRole   Role   @relation("ParentRole", fields: [parentRoleId], references: [id], onDelete: Cascade)

  @@unique([childRoleId, parentRoleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  obligations  Json?

  @@unique([roleId, permissionId])
}

/// Who has which role — a "subject" is a user or an agent, never just a
/// user, since agents are first-class actors that execute actions too.
model RoleAssignment {
  id          String      @id @default(uuid())
  subjectId   String
  subjectType SubjectType
  /// `unscoped` preserves legacy rows without granting them in any tenant.
  tenantId    String      @default("unscoped")
  roleId      String
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([subjectId, subjectType, tenantId, roleId])
  @@index([subjectId, subjectType, tenantId])
}

/// Instance-level override on top of the role-based decision — "wenn ich
/// eine externe Datenquelle anschließe, dürfen Agenten nur auf bestimmte
/// Objekte zugreifen (oder auf bestimmte Objekte keinen Zugriff haben)".
/// Each rule is local to its own object: a `deny` always blocks that one
/// object regardless of the role grant (a pure blacklist), and an `allow`
/// only matters when the role itself doesn't grant the permission at all
/// (a standalone whitelist entry) — see `authorization.service.ts` for
/// the exact resolution order.
model ObjectPermission {
  id           String       @id @default(uuid())
  subjectId    String
  subjectType  SubjectType
  /// Existing unscoped grants are retained but are not effective in a tenant.
  tenantId     String       @default("unscoped")
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  objectId     String
  effect       AccessEffect
  createdAt    DateTime     @default(now())

  @@unique([subjectId, subjectType, tenantId, permissionId, objectId])
  @@index([subjectId, subjectType, tenantId, permissionId])
}

model AuditLog {
  id                   String   @id @default(uuid())
  requestId            String?
  userId               String?
  tenantId             String?
  action               String
  resourceType         String
  resourceId           String?
  decision             String
  reason               String
  matchedPolicies      String[] @default([])
  evaluatedPermissions String[] @default([])
  obligations          Json?
  actorType            String?
  workspaceId          String?
  environmentId        String?
  createdAt            DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([decision, createdAt])
}

model Workspace {
  id          String               @id @default(uuid())
  tenantId    String
  name        String
  status      String               @default("active")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships WorkspaceMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model WorkspaceMembership {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model Environment {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  secrets     Secret[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model SecretStore {
  id            String   @id @default(uuid())
  tenantId      String
  environmentId String
  provider      String   @default("elyvion-envelope-v1")
  createdAt     DateTime @default(now())

  @@unique([tenantId, environmentId])
  @@index([tenantId])
}

model Secret {
  id            String            @id @default(uuid())
  tenantId      String
  environmentId String
  workspaceId   String?
  adapterId     String
  ownerId       String
  name          String
  type          String
  status        String            @default("active")
  currentVersion Int              @default(1)
  canonicalPath String            @unique
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  environment   Environment      @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  versions      SecretVersion[]
  references    SecretReference[]

  @@index([tenantId, environmentId, workspaceId, adapterId])
  @@index([tenantId, status])
}

model SecretVersion {
  id              String   @id @default(uuid())
  secretId        String
  version         Int
  ciphertext      String
  iv              String
  authTag         String
  wrappedDek      String
  keyIv           String
  keyAuthTag      String
  algorithm       String   @default("aes-256-gcm")
  keyVersion      String
  createdBy       String
  createdAt       DateTime @default(now())
  secret          Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, version])
  @@index([keyVersion])
}

model SecretReference {
  id              String   @id @default(uuid())
  secretId        String
  tenantId        String
  environmentId   String
  workspaceId     String?
  adapterId       String
  configKey       String
  versionPolicy   String   @default("latest")
  pinnedVersion   Int?
  requiredMinimum Int?
  canonicalPath   String   @unique
  createdAt       DateTime @default(now())
  secret          Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([environmentId, adapterId, configKey])
  @@index([tenantId, workspaceId, adapterId])
}

model SecretAccessLog {
  id            String   @id @default(uuid())
  tenantId      String
  environmentId String?
  workspaceId   String?
  adapterId     String?
  secretId      String?
  actorId       String?
  actorType     String
  action        String
  outcome       String
  reason        String?
  requestId     String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([secretId, createdAt])
  @@index([actorId, createdAt])
}

// Custom output path: pnpm dedupes identical @prisma/client versions across
// workspace packages into one physical copy, so the default (shared)
// output location gets overwritten by whichever module generates last.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleType {
  ts
  py
}

enum ModuleStatus {
  healthy
  unhealthy
  unknown
}

model Module {
  id             String       @id @default(uuid())
  name           String       @unique
  type           ModuleType
  baseUrl        String
  routePrefix    String
  healthCheckUrl String
  version        String
  status         ModuleStatus @default(unknown)
  registeredAt   DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())

  @@map("modules")
}

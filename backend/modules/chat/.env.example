PORT=3016
MODULE_NAME=chat
MODULE_BASE_URL=http://localhost:3016
MODULE_ROUTE_PREFIX=/
REGISTRY_URL=http://localhost:3010
MONGODB_URI=mongodb://localhost:27017/elyvion_chat

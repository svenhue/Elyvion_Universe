PORT=8101
MODULE_NAME=agent-engine
MODULE_BASE_URL=http://localhost:8101
MODULE_ROUTE_PREFIX=/
REGISTRY_URL=http://localhost:3010
AUTH_ISSUER_URL=http://localhost:3011
ENVIRONMENT=development
# Without this set, POST /runs replies with a clear 503 instead of a raw
# SDK exception — same convention as the chat module's LlmService.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# actions-engine's MCP endpoint — every agent's tool access goes through
# this, never a direct REST call, so agents and any other MCP client see
# exactly the same action catalog.
ACTIONS_ENGINE_MCP_URL=http://localhost:3015/mcp
